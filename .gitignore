.venv/
__pycache__/
*.pyc
build/
bin/
saves/
.cache/

# macOS Finder metadata. These were tracked for months: .gitignore only stops
# *new* files being added, so a file already in the index keeps being committed.
.DS_Store
**/.DS_Store

# ImGui window layout, rewritten on every run. AGENTS.md already treats it as
# machine-generated; tracking it just means every session has a dirty tree.
imgui.ini
imgui_layout_v*.ini
.member_profile.json


# Rendered views of the markdown working docs. Generated by
# scripts/render_docs.py; the markdown stays the only place content is edited,
# so a committed render is a second copy that is stale within hours
# (g-rule-14 class A, g-rule-19).
docs/rendered/

# The VGLC level corpus is a clone of an upstream repository, pulled in by the
# map-generation side project. It is not part of the game and must never become
# a gitlink in this tree.
SuperMarioGame/corpus/

# LaTeX intermediates. The report PDF itself is committed (the weekly reports
# are too), but everything pdflatex writes alongside it is a build output and
# is reproducible with Report/SuperMarioGame/build.sh (g-rule-19). This already
# covers Report/SuperMarioGame/main.{aux,log,out,toc} (unanchored *.aux/*.out/
# *.toc below, plus Report/**/main.log) — no separate rule needed for that path.
*.aux
*.lof
*.lot
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
Report/**/main.log
Report/**/main.pdf
Report/SuperMarioGame/img/*.pdf
# Screenshots are copied in from reports/assets/ at build time; the copies are
# build outputs, the originals are the tracked ones.
Report/SuperMarioGame/img/*.png
!Report/SuperMarioGame/img/hcmus-logo.png

# The one and only level/asset tree is SuperMarioGame/assets/. A second tree at
# the repository root used to be created by tools/generate_game_levels.cpp and
# won path resolution whenever the game was launched from here, silently serving
# stale levels (all themes flattened to "overworld", half pipes, Brick sub-level
# floors a P-Switch could delete under the player). The dual-write is gone; this
# anchored rule makes sure a stray recreation can never be committed.
/assets/

# Per-lane build trees from parallel agent work (build_r21_lane_a/ etc). The
# canonical build dir is already ignored above; these are the same thing under
# a different name and must never be committed.
SuperMarioGame/build_*/

# Levels authored in the in-game level editor. They are somebody's own content,
# written to SuperMarioGame/assets/levels/custom/ so the game can find and play
# them (LevelCatalog::customLevels) — not part of the shipped campaign, and not
# something one developer's scratch level should arrive in another's checkout.
# The directory is recreated on demand by LevelCatalog::resolvedCustomDirectory.
SuperMarioGame/assets/levels/custom/

# Root-level PDFs are stale renders of tracked markdown (SPEC.pdf, TASKS.pdf,
# TASK_DIVISION.pdf, implementation_plan.pdf) — regenerate on demand rather
# than committing a copy that drifts from its .md source (g-rule-19, g-rule-22).
# Anchored to the repo root only: submission_documents/*.pdf and
# Report/SuperMarioGame/*.pdf are real deliverables, not renders, and stay
# tracked untouched by this rule since they are not at the root.
/*.pdf

# Zip archives are build outputs of tracked directories (submission_documents/,
# docs/Group52_XX/) — reproducible on demand, never a second copy to keep in
# sync (g-rule-19).
*.zip
# Split-archive parts of the submission zip (zip -s). *.zip catches the last
# part only; these catch 52.z01, 52.z02, ... which are the same build output.
*.z[0-9][0-9]
